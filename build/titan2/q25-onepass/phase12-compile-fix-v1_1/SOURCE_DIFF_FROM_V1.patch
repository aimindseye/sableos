+def correct_dialer_default_preferences(entries: list[dict]) -> tuple[str, str]:
+    """A one-occurrence, hash-pin-preserving change of the staged candidate in RAM.
+
+    The original user-provided stage and its SHA256 pins remain unchanged. Failure
+    to find precisely the observed line is a hard hold, never a broad substitution.
+    """
+    dialer = [e for e in entries if e['relpath'] == DIALER_OWNER]
+    if len(dialer) != 1:
+        raise Hold('DIALER_OWNER_NOT_UNIQUE')
+    entry = dialer[0]
+    original = entry['_after']
+    if original.count(DIALER_OLD) != 1:
+        raise Hold('DIALER_ANDROIDX_PREFERENCE_ANCHOR_CHANGED')
+    corrected = original.replace(DIALER_OLD, DIALER_NEW, 1)
+    if b'androidx.preference.PreferenceManager' in corrected:
+        raise Hold('DIALER_UNRESOLVED_PREFERENCE_IMPORT')
+    entry['_after'] = corrected
+    entry['after_sha256'] = digest(corrected)
+    entry['bytes'] = len(corrected)
+    diff = ''.join(difflib.unified_diff(
+        original.decode('utf-8').splitlines(keepends=True),
+        corrected.decode('utf-8').splitlines(keepends=True),
+        fromfile='a/' + DIALER_OWNER,
+        tofile='b/' + DIALER_OWNER))
+    return diff, entry['after_sha256']
+
