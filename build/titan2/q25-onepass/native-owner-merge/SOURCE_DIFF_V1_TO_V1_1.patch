+    """Add the opt-in switch under an existing in-call group or the validated screen root.
+
+    Android16 Dialer branches differ in how sound_settings.xml groups preferences.
+    A missing @string/incall_category_title is not evidence of an incompatible root.
+    Do not fabricate a PreferenceCategory or rewrite existing resources.
+    """
+    if 'sable_space_answers' in text:
+        raise Hold('Dialer sound settings already exposes Space answer')
+    try:
+        screen = ET.fromstring(text)
+    except ET.ParseError as exc:
+        raise Hold(f'DIALER_SOUND_XML_INVALID: {exc}') from exc
+    # A PreferenceScreen (unqualified or package-qualified) is the only accepted parent.
+    local_name = screen.tag.rsplit('}', 1)[-1].rsplit('.', 1)[-1]
+    if local_name != 'PreferenceScreen':
+        raise Hold(f'DIALER_SOUND_XML_ROOT_UNSUPPORTED: {local_name}')
+
+    # Match a category only when it is an existing non-self-closing element.
+    category_pattern = (r'<PreferenceCategory\b[^>]*'
+                        r"\bandroid:title\s*=\s*[\"']@string/incall_category_title[\"'][^>]*>")
+    # Explicit inline pattern avoids depending on formatting/order of unrelated settings.
+    candidates = list(re.finditer(category_pattern, text, flags=re.S))
+    if len(candidates) > 1:
+        raise Hold('INCALL_PREFERENCE_CATEGORY: ambiguous multiple candidates')
+    category = candidates[0] if candidates else None
+
+    # Copy the widget class already used by the owner if available; otherwise keep
+    # the Q25 SwitchPreferenceCompat choice, whose availability needs real Gradle validation.
+    widget = 'SwitchPreferenceCompat'
+    for variant in ('androidx.preference.SwitchPreferenceCompat',
+                    'SwitchPreferenceCompat',
+                    'androidx.preference.SwitchPreference',
+                    'SwitchPreference'):
+        if re.search(r'<' + re.escape(variant) + r'(?:\s|/?>)', text):
+            widget = variant
+            break
+    pref = (f'\n        <!-- SableOS Titan2: Space answers only a single ringing call. -->\n'
+            f'        <{widget}\n'
