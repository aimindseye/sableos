# Titan 2 N1D C3 phase split.
# C3A reproduces the known Restless/Treble control. C3B is the minimal
# Sable-owned baseline derived from C3A evidence, not from wholesale inheritance.

N1D_C3_PHASE_SPLIT_VERSION=1

N1D_C3A_ROLE=RESTLESS_TREBLEDROID_REPRODUCTION_CONTROL
N1D_C3A_PRODUCT=treble_arm64_bvN
N1D_C3A_RELEASE_CONFIG=bp4a
N1D_C3A_VARIANT=user
N1D_C3A_CONTROL_PATCH_COUNT=369
N1D_C3A_FULL_RESTLESS_PATCH_STACK_ALLOWED=YES_CONTROL_ONLY
N1D_C3A_RELEASE_ELIGIBLE=NO
N1D_C3A_DEVICE_CONTACT_AUTHORIZED=NO
N1D_C3A_FLASH_AUTHORIZED=NO

N1D_C3B_ROLE=SABLE_MINIMAL_BASELINE
N1D_C3B_SOURCE_SUBSTRATE=GRAPHENEOS_A16_PINNED
N1D_C3B_TREBLEDROID_SCAFFOLD_ALLOWED=YES_PINNED_BUILD_COMPAT_ONLY
N1D_C3B_RESTLESS_FULL_PATCH_STACK_ALLOWED=NO
N1D_C3B_RUNTIME_PATCH_ALLOWLIST_INITIAL_COUNT=0
N1D_C3B_PATCH_ADMISSION_MODE=FAILURE_EVIDENCE_THEN_REVIEW_THEN_ADMIT
N1D_C3B_AOSP_PHONE_STACK=SOURCE_BUILT
N1D_C3B_STOCK_TELEPHONY_APK_IMPORT_ALLOWED=NO
N1D_C3B_STOCK_MTK_JAR_SO_IMPORT_ALLOWED=NO
N1D_C3B_FULL_VENDOR_COPY_ALLOWED=NO
N1D_C3B_STOCK_VENDOR_FIRMWARE_PRESERVE=YES
N1D_C3B_RADIO_COMPAT_MODE=EVIDENCE_DRIVEN
N1D_C3B_MTK_INDICATION_STATUS=INVESTIGATE
N1D_C3B_IMS_QNS_IWLAN_STATUS=INVESTIGATE
N1D_C3B_PHH_MTK_IMS_DEFAULT=false
N1D_C3B_APN_ONLY_FIX_ALLOWED=NO
N1D_C3B_LTE_ONLY_FIX_ALLOWED=NO
N1D_C3B_RELEASE_ELIGIBLE=NO
N1D_C3B_BUILD_AUTHORIZED=NO_UNTIL_C3A_CONTROL_EVIDENCE

N1D_C3_PHASE_SPLIT=PASS
