N1D_C3B_RUNTIME_PATCH_ALLOWLIST_INITIAL_COUNT=0
N1D_C3B_PATCH_ADMISSION_MODE=PREAUDITED_BUILD_COMPAT_RUNTIME_EVIDENCE_GATED
N1D_C3B_BUILD_COMPAT_ADMISSION_MODE=C3A_CORPUS_PREAUDIT_REPO_OWNED_NARROW_REIMPLEMENTATION
