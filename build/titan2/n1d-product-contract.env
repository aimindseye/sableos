# Titan 2 N1D product-chain contract.
# C3 is explicitly split:
#   C3A = pinned Restless/TrebleDroid public functional reproduction control
#   C3B = minimal Sable-owned baseline derived from C3A evidence

N1D_PRODUCT_CONTRACT_VERSION=5
N1D_SOURCE_LOCK_FILE=build/titan2/n1d-source-lock.env
N1D_RESTLESS_SECURITY_BOUNDARY_FILE=build/titan2/n1d-restless-security-boundary.env
N1D_C3_TREBLEDROID_PROFILE_FILE=build/titan2/n1d-c3-trebledroid.env
N1D_C3_PHASE_SPLIT_FILE=build/titan2/n1d-c3-phase-split.env

N1D_SOURCE_SUBSTRATE=GRAPHENEOS_A16_PINNED
N1D_RESTLESS_ROLE=C2_CONTROL_C3A_REPRODUCTION_REFERENCE_C3B_PATCH_SOURCE_ONLY
N1D_C3_ACTIVE_PHASE=C3A_CONTROL
N1D_C3_PRODUCT_GENERATION_MODE=PINNED_TREBLEDROID_GENERATOR

# C3A compatibility aliases used by the active build drivers.
N1D_PRODUCT_NAME=treble_arm64_bvN
N1D_PRODUCT_GENERATOR=device/phh/treble/generate.sh
N1D_PRODUCT_GENERATOR_CONFIG=rom
N1D_TREBLE_COMPAT_SUBSTRATE=device/phh/treble/base.mk
N1D_C3A_ADD_MANIFEST=build/titan2/n1d-c3a-trebledroid-add.xml
N1D_C3A_REMOVE_MANIFEST=build/titan2/n1d-c3a-trebledroid-remove.xml
N1D_C3A_REMOVE_PROJECT_MAP=build/titan2/n1d-c3a-remove-projects.tsv
N1D_C3A_BUILD_MAKE_AUDIT_SET=build/titan2/n1d-c3a-build-make-audit-set.txt
N1D_C3A_BUILD_MAKE_AUDIT_BLOBS=build/titan2/n1d-c3a-build-make-audit-blobs.tsv
N1D_C3B_RUNTIME_PATCH_ALLOWLIST=build/titan2/n1d-c3b-runtime-patch-allowlist.txt
N1D_C3A_CONTROL_GENERATOR_CONFIG=build/titan2/n1d-c3a-control-rom.mk

N1D_C3_FIRST_BUILD_RELEASE_CONFIG=bp4a
N1D_C3_FIRST_BUILD_VARIANT=user
N1D_C3_FIRST_BUILD_GOAL=systemimage
N1D_C3_BUILD_AUTHORIZED_BY_REBASELINE_STAGE=NO

N1D_DIRECT_HANDCRAFTED_GSI_PRODUCT_ALLOWED=NO
N1D_DEVICE_PHH_TREBLE_GENERATOR_USED=YES_PINNED
N1D_DEVICE_PHH_TREBLE_BASE_PRESENT=YES_COMPATIBILITY_SUBSTRATE
N1D_CONTROL_FULL_RESTLESS_PATCH_TIERS=YES_PINNED_CONTROL_ONLY
N1D_RESTLESS_FULL_PATCH_TIERS_AUTOAPPLY_ALLOWED_FOR_RELEASE=NO
N1D_CONTROL_PATCH_TIER_COUNT=5
N1D_CONTROL_PATCH_COUNT=369
N1D_RUNTIME_PATCH_ALLOWLIST_COUNT=0
N1D_C3A_BUILD_MAKE_AUDIT_SET_COUNT=9

# C3A is evidence/control only.
N1D_C3A_ROLE=RESTLESS_TREBLEDROID_REPRODUCTION_CONTROL
N1D_C3A_PRODUCT=treble_arm64_bvN
N1D_C3A_ADD_PROJECT_COUNT=12
N1D_C3A_REMOVE_PROJECT_COUNT=54
N1D_C3A_MANAGED_PROJECT_COUNT=991
N1D_C3A_CONTROL_FIDELITY=PUBLIC_FUNCTIONAL_REPRODUCTION
N1D_C3A_PRIVATE_RESTLESS_VENDOR=OMITTED
N1D_C3A_PIXEL_GSANS=OMITTED_UNPINNED_NONFUNCTIONAL
N1D_C3A_CONTROL_PATCH_COUNT=369
N1D_C3A_RELEASE_ELIGIBLE=NO
N1D_C3A_DEVICE_CONTACT_AUTHORIZED=NO
N1D_C3A_FLASH_AUTHORIZED=NO

# C3B is the future Sable baseline. It does not inherit the C3A patch stack.
N1D_C3B_ROLE=SABLE_MINIMAL_BASELINE
N1D_C3B_RESTLESS_FULL_PATCH_STACK_ALLOWED=NO
N1D_C3B_RUNTIME_PATCH_ALLOWLIST_INITIAL_COUNT=0
N1D_C3B_PATCH_ADMISSION_MODE=FAILURE_EVIDENCE_THEN_REVIEW_THEN_ADMIT
N1D_C3B_AOSP_PHONE_STACK=SOURCE_BUILT
N1D_C3B_STOCK_TELEPHONY_APK_IMPORT_ALLOWED=NO
N1D_C3B_STOCK_MTK_JAR_SO_IMPORT_ALLOWED=NO
N1D_C3B_FULL_VENDOR_COPY_ALLOWED=NO
N1D_C3B_STOCK_VENDOR_FIRMWARE_PRESERVE=YES
N1D_C3B_RADIO_COMPAT_MODE=EVIDENCE_DRIVEN
N1D_C3B_BUILD_AUTHORIZED=NO_UNTIL_C3A_CONTROL_EVIDENCE
N1D_C3B_RELEASE_ELIGIBLE=NO

N1D_RUNTIME_PRODUCT_OWNER=GENERATED_TREBLEDROID_C3A_CONTROL
N1D_STOCK_VENDOR_PRESERVE=YES
N1D_STOCK_PRODUCT_AS_RUNTIME_OWNER=NO
N1D_STOCK_SYSTEM_EXT_AS_RUNTIME_OWNER=NO

N1D_C3_RELEASE_ELIGIBLE=NO
N1D_C3_RUNTIME_SECURITY_AUDIT_REQUIRED=YES
N1D_C3_SELINUX_ENFORCING_REQUIRED_FOR_RELEASE=YES
N1D_C3_NEVERALLOW_ENFORCEMENT_REQUIRED_FOR_RELEASE=YES
N1D_C3_ADB_AUTH_REQUIRED_FOR_RELEASE=YES

N1D_PRODUCT_CONTRACT=PASS
