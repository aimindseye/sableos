# Titan 2 N1D product-chain contract.
# C3 is rebaselined on the exact successful Restless/TrebleDroid build topology.
# This contract does not make the compatibility baseline release-eligible.

N1D_PRODUCT_CONTRACT_VERSION=4
N1D_SOURCE_LOCK_FILE=build/titan2/n1d-source-lock.env
N1D_RESTLESS_SECURITY_BOUNDARY_FILE=build/titan2/n1d-restless-security-boundary.env
N1D_C3_TREBLEDROID_PROFILE_FILE=build/titan2/n1d-c3-trebledroid.env

N1D_SOURCE_SUBSTRATE=GRAPHENEOS_A16_PINNED
N1D_RESTLESS_ROLE=C2_CONTROL_AND_PINNED_C3_BUILD_RECIPE_REFERENCE
N1D_C3_PRODUCT_GENERATION_MODE=PINNED_TREBLEDROID_GENERATOR

N1D_PRODUCT_NAME=treble_arm64_bvN
N1D_PRODUCT_GENERATOR=device/phh/treble/generate.sh
N1D_PRODUCT_GENERATOR_CONFIG=sable
N1D_TREBLE_COMPAT_SUBSTRATE=device/phh/treble/base.mk
N1D_C3_SCAFFOLD_MANIFEST=build/titan2/n1d-c3-trebledroid-manifest.xml
N1D_C3_BUILD_PATCH_ALLOWLIST=build/titan2/n1d-c3-build-patch-allowlist.txt
N1D_C3_RUNTIME_PATCH_ALLOWLIST=build/titan2/n1d-c3-runtime-patch-allowlist.txt
N1D_C3_SABLE_GENERATOR_CONFIG=build/titan2/n1d-c3-sable-rom.mk

N1D_C3_FIRST_BUILD_RELEASE_CONFIG=bp4a
N1D_C3_FIRST_BUILD_VARIANT=user
N1D_C3_FIRST_BUILD_GOAL=systemimage
N1D_C3_BUILD_AUTHORIZED_BY_REBASELINE_STAGE=NO

N1D_DIRECT_HANDCRAFTED_GSI_PRODUCT_ALLOWED=NO
N1D_DEVICE_PHH_TREBLE_GENERATOR_USED=YES_PINNED
N1D_DEVICE_PHH_TREBLE_BASE_PRESENT=YES_COMPATIBILITY_SUBSTRATE
N1D_RESTLESS_FULL_PATCH_TIERS_AUTOAPPLY_ALLOWED=NO
N1D_RUNTIME_PATCH_ALLOWLIST_COUNT=0
N1D_BUILD_MAKE_PATCH_ALLOWLIST_COUNT=9

N1D_RUNTIME_PRODUCT_OWNER=GENERATED_TREBLEDROID_CONTROL_BASELINE
N1D_STOCK_VENDOR_PRESERVE=YES
N1D_STOCK_PRODUCT_AS_RUNTIME_OWNER=NO
N1D_STOCK_SYSTEM_EXT_AS_RUNTIME_OWNER=NO

N1D_C3_RELEASE_ELIGIBLE=NO
N1D_C3_RUNTIME_SECURITY_AUDIT_REQUIRED=YES
N1D_C3_SELINUX_ENFORCING_REQUIRED_FOR_RELEASE=YES
N1D_C3_NEVERALLOW_ENFORCEMENT_REQUIRED_FOR_RELEASE=YES
N1D_C3_ADB_AUTH_REQUIRED_FOR_RELEASE=YES

N1D_PRODUCT_CONTRACT=PASS
