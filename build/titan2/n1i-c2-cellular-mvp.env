# Titan 2 N1I-C2 Cellular MVP Bundle R1
# Architecture/admission contract only. This file authorizes no source mutation,
# build, device contact, reboot or flash.

N1I_C2_MVP_REVISION=R1
N1I_C2_MVP_DEVICE=TITAN_2
N1I_C2_MVP_ANDROID_PLATFORM=16
N1I_C2_MVP_GOAL=TRAY1_SINGLE_SIM_CELLULAR_WORKING_THEN_RETURN_TO_SABLEOS
N1I_C2_MVP_BASE=C3A_RESTLESS_369_PATCH_CONTROL_PLUS_PHYSICALLY_QUALIFIED_SABLE_N1F

# Keep the known broad Treble/Restless compatibility substrate. Do not peel it
# down while bringing up cellular.
N1I_C2_MVP_RESTLESS_CONTROL_PATCH_COUNT=369
N1I_C2_MVP_RESTLESS_COMPATIBILITY_SUBSTRATE=RETAIN

# OEM MediaTek IMS island.
N1I_C2_MVP_OEM_IMS_PROVIDER=com.mediatek.ims
N1I_C2_MVP_OEM_IMS_APK_SOURCE=V010014_STOCK_AUDIT_AUTHORITY
N1I_C2_MVP_REQUIRED_JAR_1=/system_ext/framework/mediatek-common.jar
N1I_C2_MVP_REQUIRED_JAR_2=/system_ext/framework/mediatek-ims-base.jar
N1I_C2_MVP_JAVA_REQUIRED_JAR_COUNT=2
N1I_C2_MVP_NATIVE_POLICY=ADMIT_EXACT_B2_SYSTEM_SIDE_STOCK_ONLY_DEPENDENCY_CLOSURE_ONCE
N1I_C2_MVP_VENDOR_NATIVE_POLICY=PRESERVE_VENDOR_DO_NOT_DUPLICATE
N1I_C2_MVP_PRIVAPP_SYSCONFIG_SELINUX=RETAIN_CURRENT_N1I_C1_ADMISSION

# Existing Restless/Treble Android-16 MTK compatibility surfaces stay enabled.
N1I_C2_MVP_UPDATE_IMS_SERVICE_CONFIG_SHIM=RETAIN
N1I_C2_MVP_GET_SIM_STATE_FOR_SLOT_INDEX_SHIM=RETAIN
N1I_C2_MVP_MTK_IMS_TELEPHONY_RRO=RETAIN_AND_VERIFY_ENABLED
N1I_C2_MVP_PHH_SIGNATURE_TRUST=RETAIN
N1I_C2_MVP_APN_DATABASE=RETAIN
N1I_C2_MVP_MTK_SMS_FRAMEWORK_READY=RETAIN
N1I_C2_MVP_MTK_RIL_COMPAT=RETAIN

# Evidence-backed Titan delta.
N1I_C2_MVP_TELEPHONYMETRICS_TWO_ARG_OVERLOAD=ADMIT
N1I_C2_MVP_TELEPHONYMETRICS_SEMANTICS=NOOP_COMPATIBILITY_ONLY
N1I_C2_MVP_INCOMING_CALL_BINDER_COMPAT=ENABLE_TITAN2_EXISTING_RESTLESS_PATH

# Add one coherent Titan cellular integration layer instead of serial ad-hoc
# patches. It owns readiness, binding, diagnostics and bounded recovery.
N1I_C2_MVP_TITAN_CELLULAR_INTEGRATION_PACKAGE=ADMIT
N1I_C2_MVP_VENDOR_UA_READINESS=VERIFY_AND_WAIT_FOR_STOCK_ATTRIBUTED_SERVICES
N1I_C2_MVP_IMS_PROVIDER_BINDING=VERIFY_MMTEL_PROVIDER_AND_REBIND_ON_BOUNDED_FAILURE
N1I_C2_MVP_PHh_MTKMAL_DISABLE_BEHAVIOR=AUDIT_AND_TITAN_GATE_IF_APPLICABLE
N1I_C2_MVP_HEALER_CODE=SHIP_DISABLED_BY_DEFAULT
N1I_C2_MVP_HEALER_TRIGGER=STATE_FAILURE_ONLY
N1I_C2_MVP_HEALER_ACTIONS=BOUNDED_IMS_ENABLE_REBIND_ONE_SHOT_REARM
N1I_C2_MVP_HEALER_RATE_LIMIT=REQUIRED
N1I_C2_MVP_HEALER_SLOT_AWARE=REQUIRED
N1I_C2_MVP_HEALER_ACTIVE_CALL_SAFE=REQUIRED
N1I_C2_MVP_HEALER_EMERGENCY_CALL_SAFE=REQUIRED
N1I_C2_MVP_HEALER_EVIDENCE_LOG=REQUIRED

# Explicitly do not block the MVP on research-heavy/non-core features.
N1I_C2_MVP_TRAY2=DEFER
N1I_C2_MVP_DSDS=DEFER
N1I_C2_MVP_DEFAULT_DATA_SWITCH=DEFER
N1I_C2_MVP_DEFAULT_VOICE_SWITCH=DEFER
N1I_C2_MVP_VOWIFI_QNS_IWLAN=DEFER
N1I_C2_MVP_ESIM=DEFER
N1I_C2_MVP_VILTE_VT=DEFER
N1I_C2_MVP_MTKRADIOEX_NEW_CLIENT=DEFER_UNLESS_RUNTIME_PROVES_REQUIRED

# AtlasOS is reference evidence, not a patch allowlist.
N1I_C2_MVP_ATLAS_TITAN_IMS_ARCHITECTURE=REFERENCE
N1I_C2_MVP_ATLAS_BLIND_SIMSWITCH_HOLD=REJECT
N1I_C2_MVP_ATLAS_PERIODIC_PROPERTY_LOOP=REJECT
N1I_C2_MVP_GENERIC_RIL_RESTART=REJECT
N1I_C2_MVP_AIRPLANE_TOGGLE_HEALER=REJECT
N1I_C2_MVP_SELINUX_PERMISSIVE_RECOVERY=REJECT
N1I_C2_MVP_REBOOT_AS_HEALING=REJECT

# MVP physical acceptance: one known-good SIM in tray 1.
N1I_C2_MVP_ACCEPT_BOOT_X3=REQUIRED
N1I_C2_MVP_ACCEPT_REGISTRATION=REQUIRED
N1I_C2_MVP_ACCEPT_DATA_STABLE_30_MIN=REQUIRED
N1I_C2_MVP_ACCEPT_SMS_MO_MT=REQUIRED
N1I_C2_MVP_ACCEPT_MMS_MO_MT=REQUIRED
N1I_C2_MVP_ACCEPT_IMS_REGISTERED=REQUIRED
N1I_C2_MVP_ACCEPT_VOICE_MO=REQUIRED
N1I_C2_MVP_ACCEPT_VOICE_MT=REQUIRED
N1I_C2_MVP_ACCEPT_REBOOT_REREGISTER=REQUIRED
N1I_C2_MVP_ACCEPT_NO_PHONE_IMS_CRASH_LOOP=REQUIRED

# Current authority. This deliverable does not itself permit execution.
N1I_C2_MVP_SOURCE_MUTATION_AUTHORIZED=NO
N1I_C2_MVP_BUILD_AUTHORIZED=NO
N1I_C2_MVP_DEVICE_CONTACT_AUTHORIZED=NO
N1I_C2_MVP_FLASH_AUTHORIZED=NO
