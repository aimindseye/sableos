# Titan 2 N1I-D0 host-only qualification configuration.
# Copy outside the repository and fill only with retained local artifacts.
#
# No network, device contact, build, reboot or flash is permitted.

DEVICE_CONTACT_AUTHORIZED=NO
BUILD_AUTHORIZED=NO
NETWORK_FETCH_AUTHORIZED=NO
REBOOT_AUTHORIZED=NO
FLASH_AUTHORIZED=NO

# Repository / Android source authority.
SABLE_REPO=/srv/sable-build/sableos/repo
ANDROID16_SOURCE_ROOT=/srv/sable-build/workspaces/titan2-n1d
ANDROID16_INIT_SELINUX_CPP=

# Known-good N1F physical control.
