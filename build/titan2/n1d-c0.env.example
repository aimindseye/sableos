# Titan 2 N1D C0 local-path configuration.
# Copy this file outside the repo/evidence output and edit paths only.

DEVICE_CONTACT_AUTHORIZED=NO
BUILD_AUTHORIZED=NO
FLASH_AUTHORIZED=NO
NETWORK_FETCH_AUTHORIZED=NO

SABLE_REPO=/srv/data/sable-build/sableos/repo
TITAN2_REPO=/srv/data/sable-build/titan2/repo
EVIDENCE_ROOT=/srv/data/sable-build/evidence/titan2

# N1C inputs sealed by docs/SABLEOS_N1C_HYBRID_SUPER_CHECKPOINT.md
N1C_WORKSPACE=/srv/data/sable-build/workspaces/titan2-n1c-android16-hybrid-super-20260930_140947
N1C_OUT_DIR=/srv/data/sable-build/workspaces/titan2-n1c-android16-hybrid-super-20260930_140947/out_n1c_aosp_arm64_systemimage_apns_source_filter
N1C_SYSTEM_IMG=/srv/data/sable-build/workspaces/titan2-n1c-android16-hybrid-super-20260930_140947/out_n1c_aosp_arm64_systemimage_apns_source_filter/target/product/generic_arm64/system.img
N1C_SUPER_IMG=/srv/data/sable-build/evidence/titan2/n1c-no-flash-hybrid-super-composition-r1f-20260930_185012/titan2-n1c-hybrid-super-r1f.sparse.img

# Stock V01.00.14 / TEE14 reference root.
STOCK_REF_DIR=/srv/data/sable-build/titan2/artifacts/stock-firmware/unihertz-device-fota-20260922/inspection/bit-equivalence/TEE14-large-reference

# Prefer an exact stock super restore artifact if STOCK_REF_DIR has no super.img.
# Leave blank only if the C0 driver can uniquely discover one under the Titan 2 evidence tree.
STOCK_SUPER_IMG=

# Optional explicit extracted first-stage/vendor ramdisk tree. If blank, the driver
# attempts read-only unpack of vendor_boot/init_boot with AOSP unpack_bootimg.
STOCK_FIRST_STAGE_TREE=

# Optional fallback control. Normally leave blank: C0 auto-binds the private,
# hash-sealed N1B known-booting Restless/Treble-derived system artifact first.
RESTLESS_SYSTEM_IMG=

# Historical N1B control defaults are known from the private first-boot ledger.
# Override only if the local workspace/evidence layout moved.
N1B_CONTROL_SYSTEM_IMG=/srv/data/sable-build/workspaces/titan2-n1b/out_sable_t2_n1_sable_gsi/target/product/tdgsi_arm64_ab/system.img
N1B_CONTROL_EXPECTED_SHA256=bc550bfaf8463324c122abb490cf4aba956b89e7e4d42168a55f0f0f0f5b638e
N1B_BOOT_PROOF=/srv/data/sable-build/sableos/repo/docs/titan2/N1B_FIRST_BOOT_LEDGER_AND_N1B2_HANDOFF.md

# Normally leave blank. C0 auto-discovers the active Restless/Treble product
# device/phh/treble/treble_arm64_bvN.mk from the Titan 2 workspaces.
N1D_PRODUCT_FILE=

# Optional historical PR207 inputs. They are non-blocking for C0 boot architecture.
N1B1_INPUT=
N1B2_INPUT=

# checkvintf optional properties. first_api_level is auto-detected when possible.
VINTF_FIRST_API_LEVEL=
VINTF_HARDWARE_SKU=

# Android split-policy compile language version. 30 is the normal modern Android value;
# change only if the target host/source tree proves a different required value.
SEPOLICY_VERSION=30

# Optional explicit host-tool overrides. Otherwise the exact N1C OUT host tools are preferred.
SIMG2IMG_TOOL=
LPUNPACK_TOOL=
LPDUMP_TOOL=
AVBTOOL_TOOL=
CHECKVINTF_TOOL=
SECILC_TOOL=
UNPACK_BOOTIMG_TOOL=
