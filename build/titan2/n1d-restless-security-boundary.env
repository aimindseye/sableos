# Titan 2 N1D Restless/Treble security boundary.
# Separates known-good Treble build scaffolding from Sable runtime policy.

N1D_RESTLESS_SECURITY_BOUNDARY_VERSION=3

N1D_RESTLESS_ROLE=C2_CONTROL_AND_PINNED_C3_BUILD_RECIPE_REFERENCE
N1D_C2_CONTROL_MODE=PINNED_PREBUILT_RESTLESS_GSI
N1D_C2_CONTROL_TAG=16.0.0-202606230923
N1D_C2_CONTROL_COMMIT=4adc5766f457849ca37e0b318bced65aef5a2233
N1D_C2_CONTROL_ARTIFACT_SHA256=52ea47d794faf6eafbb49a5f0d2301508757be0e30d1b73e033e1d5185bb492c
N1D_C2_CONTROL_SECURITY_CLAIM=NO
N1D_C2_CONTROL_SABLE_RELEASE_ARTIFACT=NO

N1D_C3_BUILD_TOPOLOGY=PINNED_TREBLEDROID_GENERATED_PRODUCT
N1D_C3_PHH_BUILD_SCAFFOLD_ALLOWED=YES_PINNED_ONLY
N1D_C3_DEVICE_PHH_TREBLE_COMMIT=39ba82ef89ff5bf6b22ca8f147dbf317bffa20ed
N1D_C3_DEVICE_PHH_TREBLE_GENERATOR_USED=YES
N1D_C3_GENERATED_PRODUCT=treble_arm64_bvN
N1D_C3_BUILD_MAKE_PATCH_SOURCE=PINNED_RESTLESS_TAG
N1D_C3_BUILD_MAKE_PATCH_COUNT=9

N1D_C3_RESTLESS_FULL_PATCH_TIERS_AUTOAPPLY_ALLOWED=NO
N1D_C3_TREBLEDROID_RUNTIME_PATCH_AUTOAPPLY_ALLOWED=NO
N1D_C3_RUNTIME_PATCH_ALLOWLIST_COUNT=0
N1D_C3_PRIVATE_RESTLESS_VENDOR_ALLOWED=NO
N1D_C3_PUBLIC_ONLY_REQUIRED=YES

# device/phh/treble/base.mk is compatibility substrate, not Sable security policy.
# These upstream mechanisms may be present in the first control build and must
# be audited/remediated before any Sable release artifact is eligible.
N1D_C3_PHH_BASE_RUNTIME_SECURITY_TRUST=NO
N1D_C3_PHH_INSECURE_DEFAULTS_REQUIRE_AUDIT=YES
N1D_C3_SELINUX_IGNORE_NEVERALLOWS_RELEASE_ALLOWED=NO
N1D_C3_RO_ADB_SECURE_ZERO_RELEASE_ALLOWED=NO
N1D_C3_PHH_REMOTE_DEBUG_RELEASE_ALLOWED=NO
N1D_C3_PHHSU_RELEASE_ALLOWED=NO
N1D_C3_VENDOR_MAGISK_RELEASE_ALLOWED=NO
N1D_C3_PHH_OTA_RELEASE_ALLOWED=NO

N1D_C3_RELEASE_ELIGIBLE=NO
N1D_C3_RELEASE_REQUIRES_RUNTIME_SECURITY_CLOSURE=YES
N1D_C3_MTK_COMPAT_CHANGES_REQUIRE_REPRODUCED_FAILURE=YES
N1D_C3_KEYLAYOUT_OWNER_MUST_BE_TITAN_PROFILE=YES

N1D_RESTLESS_SECURITY_BOUNDARY=PASS
