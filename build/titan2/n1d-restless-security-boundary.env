# PHH runtime behavior is not accepted as Sable policy merely because the
# pinned Treble base contains it. E1 removes the highest-risk control/runtime
# hooks before the first C3B engineering compile; later compatibility changes
# remain evidence-gated.
N1D_C3_PHH_BASE_RUNTIME_SECURITY_TRUST=NO
N1D_C3_PHH_INSECURE_DEFAULTS_REQUIRE_AUDIT=YES
N1D_C3_SELINUX_IGNORE_NEVERALLOWS_RELEASE_ALLOWED=NO
