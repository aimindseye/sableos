# Current product-baseline release-candidate profile.
# Operators do not create per-release scripts. The canonical entry point
# build/panther/run-release.sh supplies SABLEOS_RELEASE_VERSION (for example R9).
# R8 remains the compatibility default for older direct callers.

export SABLEOS_RELEASE_VERSION="${SABLEOS_RELEASE_VERSION:-R8}"
export SABLEOS_BUILD_PROFILE_VERSION=1

export SABLE_BUILD_ROOT="${SABLE_BUILD_ROOT:-/srv/data/sable-build}"
export SABLEOS_REPO="${SABLEOS_REPO:-$SABLE_BUILD_ROOT/sableos/repo}"
export SABLEOS_UPSTREAM="${SABLEOS_UPSTREAM:-$SABLE_BUILD_ROOT/workspaces/r8-a4-panther-base-2026081300}"

export SABLE_R8_SOURCE_CACHE_ROOT="${SABLE_R8_SOURCE_CACHE_ROOT:-$SABLE_BUILD_ROOT/sources/r8-upstreams}"
export SABLE_R8_READER_CACHE="${SABLE_R8_READER_CACHE:-$SABLE_R8_SOURCE_CACHE_ROOT/vaachak-mobile}"
export SABLE_R8_TEXTREADER_CACHE="${SABLE_R8_TEXTREADER_CACHE:-$SABLE_R8_SOURCE_CACHE_ROOT/vaachak-textreader}"
export SABLE_R8_MAIL_CACHE="${SABLE_R8_MAIL_CACHE:-$SABLE_R8_SOURCE_CACHE_ROOT/thunderbird-android}"

export SABLE_R8_EVIDENCE_ROOT="${SABLE_R8_EVIDENCE_ROOT:-$SABLE_BUILD_ROOT/evidence/panther/r8-final-ui}"
export SABLE_R8_ARTIFACT_ROOT="${SABLE_R8_ARTIFACT_ROOT:-$SABLE_BUILD_ROOT/artifacts/panther/r8-final-app-bundle}"
export SABLE_R8_APP_WORK_ROOT="${SABLE_R8_APP_WORK_ROOT:-$SABLE_BUILD_ROOT/workspaces/r8-final-app-builds}"

# Stable output name. Exact source and artifact identities are carried by evidence,
# bundle manifests and the generated CI driver rather than by ad hoc OUT_DIR names.
export SABLE_R8_OUT_DIR="${SABLE_R8_OUT_DIR:-out_sable_r8_final}"
