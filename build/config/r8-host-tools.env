# Legacy compatibility profile for accepted Panther R8/R9 build scripts.
# Canonical tool storage is global under /srv/data/sable-host-tools and never
# contains release, device, milestone, or build names.

export SABLE_ANDROID_API=36
export SABLE_ANDROID_BUILD_TOOLS_VERSION=36.0.0
export SABLE_ANDROID_NDK_VERSION=30.0.16248370
export SABLE_RUST_VERSION=1.98.1
export SABLE_RUST_TOOLCHAIN=1.98.1-x86_64-unknown-linux-gnu
export SABLE_RUST_HOST=x86_64-unknown-linux-gnu
export SABLE_RUST_TARGET=aarch64-linux-android

_R8_HOST_TOOLS_CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "$_R8_HOST_TOOLS_CONFIG_DIR/host-tools.env"
unset _R8_HOST_TOOLS_CONFIG_DIR

# Keep the accepted Panther contract explicit while the implementation is
# provided by the global profile.
: "${SABLE_SECURITY_BIN:?}"
: "${SABLE_CARGO_LLVM_COV:?}"
: "${SABLE_GITLEAKS:?}"
: "${SABLE_MOBSFSCAN:?}"
: "${SABLE_MOBSFSCAN_VENV:?}"
