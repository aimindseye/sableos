# Canonical SableOS build-storage profile.
#
# The dedicated Sable build filesystem is mounted canonically at /srv/sable-build.
# /srv/data/sable-build is a temporary compatibility alias for historical paths.
# New build logic must use SABLE_BUILD_ROOT and derived variables rather than
# hard-coding either mountpoint.

export SABLE_BUILD_ROOT="${SABLE_BUILD_ROOT:-/srv/sable-build}"
export SABLE_BUILD_LEGACY_ROOT="${SABLE_BUILD_LEGACY_ROOT:-/srv/data/sable-build}"

export SABLE_BUILD_FS_LABEL_EXPECTED="${SABLE_BUILD_FS_LABEL_EXPECTED:-sable-build}"
export SABLE_BUILD_FS_TYPE_EXPECTED="${SABLE_BUILD_FS_TYPE_EXPECTED:-ext4}"
export SABLE_BUILD_MIN_FREE_GIB="${SABLE_BUILD_MIN_FREE_GIB:-250}"

export SABLE_WORKSPACES_ROOT="${SABLE_WORKSPACES_ROOT:-$SABLE_BUILD_ROOT/workspaces}"
export SABLE_EVIDENCE_ROOT="${SABLE_EVIDENCE_ROOT:-$SABLE_BUILD_ROOT/evidence}"
export SABLE_DEVICE_EVIDENCE_ROOT="${SABLE_DEVICE_EVIDENCE_ROOT:-$SABLE_EVIDENCE_ROOT}"
export SABLE_ARTIFACTS_ROOT="${SABLE_ARTIFACTS_ROOT:-$SABLE_BUILD_ROOT/artifacts}"
export SABLE_RELEASE_REGISTRY_ROOT="${SABLE_RELEASE_REGISTRY_ROOT:-$SABLE_BUILD_ROOT/release-registry}"
export SABLE_SABLEOS_ROOT="${SABLE_SABLEOS_ROOT:-$SABLE_BUILD_ROOT/sableos}"
export SABLE_TITAN2_ROOT="${SABLE_TITAN2_ROOT:-$SABLE_BUILD_ROOT/titan2}"

export SABLE_STORAGE_COMPATIBILITY_ALIAS_REQUIRED="${SABLE_STORAGE_COMPATIBILITY_ALIAS_REQUIRED:-YES}"
