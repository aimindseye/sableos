# Canonical Panther development substrate.
# Source this from Sable build scripts; do not treat BUILD_NUMBER/DATETIME as immutable release values.

export SABLEOS_DEVICE=panther
export SABLEOS_GRAPHENE_TAG=2026081300
export SABLEOS_ANDROID_VERSION=17
export SABLEOS_LUNCH_TARGET=panther-cur-user
export SABLEOS_BUILD_ID_REFERENCE=CP2A.260705.006
export SABLEOS_SECURITY_PATCH_REFERENCE=2026-08-05

# Repository-owned module location inside the upstream Android tree.
export SABLEOS_SABLESTART_REL=packages/apps/SableStart

# Local layout. Override SABLEOS_ROOT before sourcing to relocate the whole build farm.
export SABLEOS_ROOT="${SABLEOS_ROOT:-/srv/data/sableos}"
export SABLEOS_REPO="${SABLEOS_REPO:-$SABLEOS_ROOT/repo}"
export SABLEOS_UPSTREAM="${SABLEOS_UPSTREAM:-$SABLEOS_ROOT/upstream/panther/grapheneos-2026081300}"
export SABLEOS_OUT="${SABLEOS_OUT:-$SABLEOS_ROOT/build/panther/grapheneos-2026081300}"
export SABLEOS_EVIDENCE="${SABLEOS_EVIDENCE:-$SABLEOS_ROOT/evidence/panther}"
export SABLEOS_HOST_TOOLS="${SABLEOS_HOST_TOOLS:-$SABLEOS_ROOT/host-tools}"
