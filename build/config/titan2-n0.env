# Titan 2 N0_A16 build-target contract.
# This file does not authorize network bootstrap, build or device mutation.

export SABLEOS_DEVICE=titan2
export SABLEOS_RELEASE_VERSION="${SABLEOS_RELEASE_VERSION:-R10}"
export SABLE_TITAN2_RELEASE_ID="${SABLE_TITAN2_RELEASE_ID:-N0_A16}"

export SABLE_TITAN2_ARTIFACT_KIND=gsi-system-image
export SABLE_TITAN2_PRIMARY_ARTIFACT=system
export SABLE_TITAN2_REQUIRED_ANDROID_RELEASE=16
export SABLE_TITAN2_REQUIRED_PLATFORM_SDK=36
export SABLE_TITAN2_STOCK_VENDOR_API=34
export SABLE_TITAN2_STOCK_VNDK=34
export SABLE_TITAN2_ARCH=arm64

# First pinned N0_A16 substrate. A clean AOSP16 GSI is intentionally used before
# RestlessOS so the first boot/build isolates stock vendor compatibility.
export SABLE_TITAN2_AOSP_MANIFEST_URL="${SABLE_TITAN2_AOSP_MANIFEST_URL:-https://android.googlesource.com/platform/manifest}"
export SABLE_TITAN2_AOSP_TAG="${SABLE_TITAN2_AOSP_TAG:-android-16.0.0_r4}"
export SABLE_TITAN2_AOSP_BUILD_ID_REFERENCE=BP4A.251205.006
export SABLE_TITAN2_AOSP_SECURITY_PATCH_REFERENCE=2025-12-05
export SABLE_TITAN2_LUNCH_TARGET="${SABLE_TITAN2_LUNCH_TARGET:-gsi_arm64-userdebug}"

export SABLE_TITAN2_RESTLESSOS_ROLE=reference-and-future-fork
export SABLE_TITAN2_RESTLESSOS_FIRST_BOOT_DEPENDENCY=NO

export SABLE_BUILD_ROOT="${SABLE_BUILD_ROOT:-/srv/data/sable-build}"
export SABLE_TITAN2_UPSTREAM="${SABLE_TITAN2_UPSTREAM:-$SABLE_BUILD_ROOT/workspaces/titan2-aosp-$SABLE_TITAN2_AOSP_TAG}"
export SABLE_TITAN2_OUT="${SABLE_TITAN2_OUT:-$SABLE_BUILD_ROOT/out/titan2/$SABLE_TITAN2_RELEASE_ID-$SABLE_TITAN2_AOSP_TAG}"
export SABLE_TITAN2_EVIDENCE="${SABLE_TITAN2_EVIDENCE:-$SABLE_BUILD_ROOT/evidence/titan2/$SABLE_TITAN2_RELEASE_ID-$SABLE_TITAN2_AOSP_TAG}"
