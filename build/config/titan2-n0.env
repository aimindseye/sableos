# Titan 2 N0 build-target contract.
# This file does not authorize network bootstrap, build or device mutation.

export SABLEOS_DEVICE=titan2
export SABLEOS_RELEASE_VERSION="${SABLEOS_RELEASE_VERSION:-R10}"

export SABLE_TITAN2_ARTIFACT_KIND=gsi-system-image
export SABLE_TITAN2_PRIMARY_ARTIFACT=system
export SABLE_TITAN2_REQUIRED_ANDROID_RELEASE=16
export SABLE_TITAN2_REQUIRED_PLATFORM_SDK=36
export SABLE_TITAN2_STOCK_VENDOR_API=34
export SABLE_TITAN2_STOCK_VNDK=34
export SABLE_TITAN2_ARCH=arm64

export SABLE_BUILD_ROOT="${SABLE_BUILD_ROOT:-/srv/data/sable-build}"
export SABLE_TITAN2_OUT="${SABLE_TITAN2_OUT:-$SABLE_BUILD_ROOT/out/titan2/r10-n0}"
export SABLE_TITAN2_EVIDENCE="${SABLE_TITAN2_EVIDENCE:-$SABLE_BUILD_ROOT/evidence/titan2/r10-n0}"
