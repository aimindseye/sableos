# Canonical SableOS host-tool profile.
# Device-, release-, and build-independent. All Sable-managed host tools live
# under SABLE_HOST_TOOLS_ROOT. Build scripts must not discover tools from
# historical Android OUT directories or milestone-specific tool directories.

export SABLE_HOST_TOOLS_ROOT="${SABLE_HOST_TOOLS_ROOT:-/srv/data/sable-host-tools}"

export SABLE_ANDROID_TOOLS_ROOT="${SABLE_ANDROID_TOOLS_ROOT:-$SABLE_HOST_TOOLS_ROOT/android}"
export SABLE_ANDROID_SDK="${SABLE_ANDROID_SDK:-$SABLE_ANDROID_TOOLS_ROOT/sdk}"
export SABLE_ANDROID_PLATFORM_TOOLS="${SABLE_ANDROID_PLATFORM_TOOLS:-$SABLE_ANDROID_SDK/platform-tools}"

# Canonical AOSP-built host-tool bundle. It is populated from a qualified clean
# source build and is never named after the build that produced it.
export SABLE_AOSP_HOST_TOOLS_ROOT="${SABLE_AOSP_HOST_TOOLS_ROOT:-$SABLE_ANDROID_TOOLS_ROOT/aosp-host}"
export SABLE_AOSP_HOST_BIN="${SABLE_AOSP_HOST_BIN:-$SABLE_AOSP_HOST_TOOLS_ROOT/bin}"
export SABLE_AOSP_HOST_LIB="${SABLE_AOSP_HOST_LIB:-$SABLE_AOSP_HOST_TOOLS_ROOT/lib}"
export SABLE_AOSP_HOST_LIB64="${SABLE_AOSP_HOST_LIB64:-$SABLE_AOSP_HOST_TOOLS_ROOT/lib64}"
export SABLE_AOSP_HOST_LIBRARY_PATH="${SABLE_AOSP_HOST_LIBRARY_PATH:-$SABLE_AOSP_HOST_LIB64:$SABLE_AOSP_HOST_LIB}"

export SABLE_LPDUMP="${SABLE_LPDUMP:-$SABLE_AOSP_HOST_BIN/lpdump}"
export SABLE_LPUNPACK="${SABLE_LPUNPACK:-$SABLE_AOSP_HOST_BIN/lpunpack}"
export SABLE_LPMAKE="${SABLE_LPMAKE:-$SABLE_AOSP_HOST_BIN/lpmake}"
export SABLE_SIMG2IMG="${SABLE_SIMG2IMG:-$SABLE_AOSP_HOST_BIN/simg2img}"
export SABLE_IMG2SIMG="${SABLE_IMG2SIMG:-$SABLE_AOSP_HOST_BIN/img2simg}"
export SABLE_AVBTOOL="${SABLE_AVBTOOL:-$SABLE_AOSP_HOST_BIN/avbtool}"
export SABLE_CHECKVINTF="${SABLE_CHECKVINTF:-$SABLE_AOSP_HOST_BIN/checkvintf}"
export SABLE_SECILC="${SABLE_SECILC:-$SABLE_AOSP_HOST_BIN/secilc}"
export SABLE_UNPACK_BOOTIMG="${SABLE_UNPACK_BOOTIMG:-$SABLE_AOSP_HOST_BIN/unpack_bootimg}"

export SABLE_REPO_TOOLS_ROOT="${SABLE_REPO_TOOLS_ROOT:-$SABLE_HOST_TOOLS_ROOT/repo}"
export SABLE_REPO_TOOL="${SABLE_REPO_TOOL:-$SABLE_REPO_TOOLS_ROOT/repo}"

export SABLE_JAVA_TOOLS_ROOT="${SABLE_JAVA_TOOLS_ROOT:-$SABLE_HOST_TOOLS_ROOT/java}"
export SABLE_JDK17="${SABLE_JDK17:-$SABLE_JAVA_TOOLS_ROOT/jdk17}"
export SABLE_JDK21="${SABLE_JDK21:-$SABLE_JAVA_TOOLS_ROOT/jdk21}"

# Version selectors may be overridden by a release profile. The storage layout
# remains global and never contains release/build names.
export SABLE_ANDROID_API="${SABLE_ANDROID_API:-36}"
export SABLE_ANDROID_BUILD_TOOLS_VERSION="${SABLE_ANDROID_BUILD_TOOLS_VERSION:-36.0.0}"
export SABLE_ANDROID_NDK_VERSION="${SABLE_ANDROID_NDK_VERSION:-30.0.16248370}"
export SABLE_RUST_VERSION="${SABLE_RUST_VERSION:-1.98.1}"
export SABLE_RUST_TOOLCHAIN="${SABLE_RUST_TOOLCHAIN:-${SABLE_RUST_VERSION}-x86_64-unknown-linux-gnu}"
export SABLE_RUST_HOST="${SABLE_RUST_HOST:-x86_64-unknown-linux-gnu}"
export SABLE_RUST_TARGET="${SABLE_RUST_TARGET:-aarch64-linux-android}"

export SABLE_ANDROID_BUILD_TOOLS="${SABLE_ANDROID_BUILD_TOOLS:-$SABLE_ANDROID_SDK/build-tools/$SABLE_ANDROID_BUILD_TOOLS_VERSION}"
export SABLE_ANDROID_NDK="${SABLE_ANDROID_NDK:-$SABLE_ANDROID_SDK/ndk/$SABLE_ANDROID_NDK_VERSION}"
export SABLE_ADB="${SABLE_ADB:-$SABLE_ANDROID_PLATFORM_TOOLS/adb}"
export SABLE_FASTBOOT="${SABLE_FASTBOOT:-$SABLE_ANDROID_PLATFORM_TOOLS/fastboot}"
export SABLE_SDKMANAGER="${SABLE_SDKMANAGER:-$SABLE_ANDROID_SDK/cmdline-tools/latest/bin/sdkmanager}"
export SABLE_APKANALYZER="${SABLE_APKANALYZER:-$SABLE_ANDROID_SDK/cmdline-tools/latest/bin/apkanalyzer}"

export SABLE_RUST_ROOT="${SABLE_RUST_ROOT:-$SABLE_HOST_TOOLS_ROOT/rust}"
export SABLE_CARGO_HOME="${SABLE_CARGO_HOME:-$SABLE_RUST_ROOT/$SABLE_RUST_VERSION/cargo}"
export SABLE_RUSTUP_HOME="${SABLE_RUSTUP_HOME:-$SABLE_RUST_ROOT/$SABLE_RUST_VERSION/rustup}"
export SABLE_RUST_TOOLCHAIN_ROOT="${SABLE_RUST_TOOLCHAIN_ROOT:-$SABLE_RUSTUP_HOME/toolchains/$SABLE_RUST_TOOLCHAIN}"
export SABLE_CARGO="${SABLE_CARGO:-$SABLE_RUST_TOOLCHAIN_ROOT/bin/cargo}"
export SABLE_RUSTC="${SABLE_RUSTC:-$SABLE_RUST_TOOLCHAIN_ROOT/bin/rustc}"
export SABLE_RUSTUP="${SABLE_RUSTUP:-$SABLE_CARGO_HOME/bin/rustup}"

export SABLE_GRADLE_USER_HOME="${SABLE_GRADLE_USER_HOME:-$SABLE_HOST_TOOLS_ROOT/gradle}"

export SABLE_SECURITY_TOOLS_ROOT="${SABLE_SECURITY_TOOLS_ROOT:-$SABLE_HOST_TOOLS_ROOT/security}"
export SABLE_SECURITY_BIN="${SABLE_SECURITY_BIN:-$SABLE_SECURITY_TOOLS_ROOT/bin}"
export SABLE_CARGO_AUDIT="${SABLE_CARGO_AUDIT:-$SABLE_SECURITY_BIN/cargo-audit}"
export SABLE_CARGO_DENY="${SABLE_CARGO_DENY:-$SABLE_SECURITY_BIN/cargo-deny}"
export SABLE_CARGO_LLVM_COV="${SABLE_CARGO_LLVM_COV:-$SABLE_SECURITY_BIN/cargo-llvm-cov}"
export SABLE_GITLEAKS="${SABLE_GITLEAKS:-$SABLE_SECURITY_BIN/gitleaks}"
export SABLE_MOBSFSCAN="${SABLE_MOBSFSCAN:-$SABLE_SECURITY_BIN/mobsfscan}"

export SABLE_PYTHON="${SABLE_PYTHON:-/usr/bin/python3}"
export SABLE_MOBSFSCAN_COMMIT="${SABLE_MOBSFSCAN_COMMIT:-a43635d92434e78b079ed7d860f022cf6c886b43}"
export SABLE_MOBSFSCAN_VERSION="${SABLE_MOBSFSCAN_VERSION:-1.0.0}"
export SABLE_MOBSFSCAN_ROOT="${SABLE_MOBSFSCAN_ROOT:-$SABLE_SECURITY_TOOLS_ROOT/mobsfscan/$SABLE_MOBSFSCAN_COMMIT}"
export SABLE_MOBSFSCAN_SOURCE="${SABLE_MOBSFSCAN_SOURCE:-$SABLE_MOBSFSCAN_ROOT/source}"
export SABLE_MOBSFSCAN_VENV="${SABLE_MOBSFSCAN_VENV:-$SABLE_MOBSFSCAN_ROOT/venv}"
export SABLE_MOBSFSCAN_PYTHON="${SABLE_MOBSFSCAN_PYTHON:-$SABLE_MOBSFSCAN_VENV/bin/python}"
export SABLE_MOBSFSCAN_PIP="${SABLE_MOBSFSCAN_PIP:-$SABLE_MOBSFSCAN_VENV/bin/pip}"

_sable_host_path_prepend() {
    local d="$1"
    [[ -n "$d" ]] || return 0
    case ":$PATH:" in
        *":$d:"*) ;;
        *) PATH="$d:$PATH" ;;
    esac
}

_sable_host_path_prepend "$SABLE_SECURITY_BIN"
_sable_host_path_prepend "$SABLE_RUST_TOOLCHAIN_ROOT/bin"
_sable_host_path_prepend "$SABLE_CARGO_HOME/bin"
_sable_host_path_prepend "$SABLE_ANDROID_SDK/cmdline-tools/latest/bin"
_sable_host_path_prepend "$SABLE_ANDROID_BUILD_TOOLS"
_sable_host_path_prepend "$SABLE_ANDROID_PLATFORM_TOOLS"
_sable_host_path_prepend "$SABLE_AOSP_HOST_BIN"
_sable_host_path_prepend "$SABLE_REPO_TOOLS_ROOT"
export PATH
unset -f _sable_host_path_prepend
