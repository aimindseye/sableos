# SableOS R8 first-party application product integration.
#
# Launcher3QuickStep remains the platform launcher package and is transformed
# into the Sable HOME by the R9 foundation applicator. The applications below
# are standalone qualified APKs staged into vendor/sable/r8/prebuilt.

PRODUCT_PACKAGES += \
    SableCalculator \
    SableSudoku \
    SableMinesweeper \
    Sable2048 \
    SableMedia \
    SableReader \
    SableHub \
    SableMail
