// Titan 2 N1I-C2 Cellular MVP compatibility island.
// Proprietary payload bytes are staged from the sealed C2 materialization
// bundle at build time and are never committed to Git.
//
// C2 retains 33-path native closure authority, but defines only the 28
// collision-qualified frozen imports. Five reviewed Android 16 platform
// providers remain authoritative and therefore have no Sable prebuilt module.
// Imported module stems preserve the exact stock SONAME/install filename.

sh_binary {
    name: "SableTitan2Cellular",
    src: "sable-titan2-cellular.sh",
    filename: "sable-titan2-cellular",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "SableTitan2CellularInit",
    src: "sable-titan2-cellular.rc",
    filename: "sable-titan2-cellular.rc",
    sub_dir: "init",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "SableTitan2CellularConfig",
    src: "prebuilt/system_ext/etc/sable/titan2-cellular.conf",
    filename: "titan2-cellular.conf",
    sub_dir: "sable",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "SableTitan2CellularMarker",
    src: "titan2-cellular-mvp",
    filename: "titan2-cellular-mvp",
    sub_dir: "sable",
    system_ext_specific: true,
}

cc_prebuilt_library_shared {
    name: "SableN1IC2NativeM007",
    srcs: ["prebuilt/system_ext/lib64/vendor.mediatek.hardware.mtkradioex.se-V1-ndk.so"],
    stem: "vendor.mediatek.hardware.mtkradioex.se-V1-ndk",
    compile_multilib: "64",
    strip: {
        none: true,
    },
    check_elf_files: false,
    system_ext_specific: true,
}


