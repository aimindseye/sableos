rust_binary {
    name: "oxynoded",
    crate_name: "oxynoded",
    srcs: ["src/main.rs"],
    system_ext_specific: true,
    prefer_rlib: true,
}

prebuilt_etc {
    name: "oxynoded_init_rc",
    src: "oxynoded.rc",
    filename: "oxynoded.rc",
    sub_dir: "init",
    system_ext_specific: true,
}
