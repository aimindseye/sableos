// R9L7 phase 2: Sable Start is presentation-only.
// Launcher3QuickStep owns HOME, app inventory, launch/details, widgets, shortcuts,
// Recents/Overview, task animations, and the org.sableos.start.appearance provider.
// No standalone SableStart APK or JNI runtime exists after the HOME cutover.
filegroup {
    name: "sable_start_presentation_srcs",
    srcs: [
        "src/com/sable/start/live/LiveSurfaceModels.kt",
        "src/com/sable/start/model/AppEntry.kt",
        "src/com/sable/start/platform/LiveSurfaceRepository.kt",
        "src/com/sable/start/platform/SableAppearanceProvider.kt",
        "src/com/sable/start/platform/StartStateRepository.kt",
        "src/com/sable/start/ui/SableStartScreen.kt",
    ],
}
