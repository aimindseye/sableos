# Titan 2 N1I-B machine-readable decisions.
# Companion to docs/titan2/N1I_B_TREBLEDROID_MTK_IMS_CAPABILITY_ANALYSIS.md.
# Source analysis only. No device contact, no build, no flash, no install.
# build/titan2/audit-n1i-b-trebledroid-mtk-ims-capability.sh checks that the
# report states every value below.

N1I_B_ENV_VERSION=1
N1I_B_BASE_MAIN=20d8df8ff97706c73b2bdbf522fbf3c75abfc6a1
N1I_B_DEVICE_EXECUTION_AUTHORIZED=NO

# B2 - TrebleDroid MediaTek IMS option
TREBLEDROID_MTK_IMS_AVAILABLE=YES
TREBLEDROID_MTK_IMS_PACKAGE=ims-mtk-u-resigned.apk
TREBLEDROID_MTK_IMS_ALREADY_LOCAL=NO
NETWORK_FETCH_REQUIRED=YES
TREBLEDROID_MTK_IMS_EXPECTED_SERVICE_PACKAGE=com.mediatek.ims

# B3 - provider routing
CONFIGURATION_POINTS_TO_MISSING_PROVIDER=YES

# B6 - mtkNetworkIndication
MTK_NETWORK_INDICATION_NULL_ROOT_CAUSE=UNPROVEN

# B7 - hypotheses
P1_CAPABILITY_SLOT_MISMATCH_EXPLAINS_TRAY2_FAILURE=PARTIALLY_SUPPORTED
P2_PROPERTY_FORCING_EQUALS_REAL_CAPABILITY_SWITCH=CONTRADICTED
P3_MISSING_IMS_CAN_CAUSE_INCOMING_CALL_FAILURE=SUPPORTED
P4_MISSING_IMS_CAUSES_CAUSE_13=CONTRADICTED
P5_MTK_NETWORK_INDICATION_NULL_CAUSES_LTE_DATA_TEARDOWN=UNPROVEN
P6_OEM_MTKIMS_REQUIRED_BEFORE_GSI_NATIVE_MTK_IMS=CONTRADICTED
P7_SYSTEM_ONLY_TITAN_GSI_REMAINS_VIABLE=PARTIALLY_SUPPORTED
P8_STOCK_SUPER_SYSTEM_EXT_HYBRID_REQUIRED=UNPROVEN

# B5 - AtlasOS behavior classification (exactly one class each)
ATLAS_CLASS_PHH_IMS_MTK_PROP=NOT_JUSTIFIED_BY_CURRENT_EVIDENCE
ATLAS_CLASS_MTK_IMS_OVERLAYS=ALREADY_IN_C3A
ATLAS_CLASS_SET_IMS_SERVICE=BOOT_RACE_WORKAROUND
ATLAS_CLASS_IMS_ENABLE=RECOVERY/HEALING_WORKAROUND
ATLAS_CLASS_FORCE_CARRIER_CONFIG=CARRIER_SPECIFIC_OVERRIDE
ATLAS_CLASS_DATA_ROAMING_UPDATE=NOT_JUSTIFIED_BY_CURRENT_EVIDENCE
ATLAS_CLASS_IMS_APN_INSERT=CARRIER_SPECIFIC_OVERRIDE
ATLAS_CLASS_PREFERRED_NETWORK_MODE=NOT_JUSTIFIED_BY_CURRENT_EVIDENCE
ATLAS_CLASS_VENDOR_SIMSWITCH_FORCE=CAPABILITY_SWITCH_WORKAROUND
ATLAS_CLASS_C_CAPABILITY_SLOT_FORCE=CAPABILITY_SWITCH_WORKAROUND
ATLAS_CLASS_SIMSWITCH_HOLD_5S=RECOVERY/HEALING_WORKAROUND
ATLAS_CLASS_VOLTE_UA_MANUAL_START=REQUIRED_ONLY_WITH_OEM_MTKIMS
ATLAS_CLASS_IMSSERVICE_KILL_REARM=BOOT_RACE_WORKAROUND
ATLAS_CLASS_INCOMING_BINDER_THREAD=ALREADY_IN_C3A
ATLAS_CLASS_SELINUX_PERMISSIVE_FALLBACK=UNSAFE_OR_NOT_ACCEPTABLE_FOR_SABLEOS
ATLAS_CLASS_QNS_WFC_ACTIVATION=CARRIER_SPECIFIC_OVERRIDE
ATLAS_CLASS_VOICE_SIM_DRIVES_CAPABILITY=CAPABILITY_SWITCH_WORKAROUND
ATLAS_CLASS_VILTE_SUPPORT_ZERO=REQUIRED_ONLY_WITH_OEM_MTKIMS
ATLAS_CLASS_VOLTE_WFC_DBG_OVERRIDES=ALREADY_IN_C3A
ATLAS_CLASS_PM_INSTALL_MTKIMS=REQUIRED_ONLY_WITH_OEM_MTKIMS
ATLAS_CLASS_VENDOR_MTK_PROP_FORCING=NOT_JUSTIFIED_BY_CURRENT_EVIDENCE
ATLAS_CLASS_MULTI_SIM_SETTINGS_WRITES=NOT_JUSTIFIED_BY_CURRENT_EVIDENCE
ATLAS_CLASS_BIND_ALL_PRESENT_SLOTS=REQUIRED_ONLY_WITH_OEM_MTKIMS

# Final decisions (YES | NO | UNPROVEN)
TRAY2_CAPABILITY_MISMATCH_RELEVANCE=UNPROVEN
REAL_CAPABILITY_SWITCH_IMPLEMENTATION=NO
PROPERTY_HOLD_REQUIRED=NO
TREBLEDROID_MTK_IMS_FIRST_TRIAL=YES
OEM_MTKIMS_NEXT_IF_GSI_IMS_FAILS=YES
FRAMEWORK_PATCH_REQUIRED_NOW=NO
MTK_RADIOEX_SHIM_REQUIRED_NOW=NO
SYSTEM_ONLY_ARCHITECTURE_VIABLE=UNPROVEN
STOCK_SUPER_HYBRID_REQUIRED_NOW=NO
