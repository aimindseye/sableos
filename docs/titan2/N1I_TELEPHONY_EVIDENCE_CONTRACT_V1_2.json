{
  "contract_id": "N1I_TELEPHONY_EVIDENCE_NORMALIZER",
  "version": "1.2",
  "status": "DESIGN_ONLY_NOT_PRODUCTION_AUTHORIZED",
  "title": "N1I Telephony Evidence Normalizer and Qualification Contract v1.2",
  "scope": "EVIDENCE_NORMALIZATION_AND_QUALIFICATION_ONLY",
  "recovery_execution": "OUT_OF_SCOPE_PENDING_ROOT_CAUSE",
  "scope_exclusions": [
    "IMS_REGISTRATION",
    "IMS_BEARER",
    "VOICE",
    "SMS_MMS"
  ],
  "execution_enabled": false,
  "authority": {
    "device_contact": false,
    "adb": false,
    "fastboot": false,
    "sim_movement": false,
    "settings_mutation": false,
    "source_mutation": false,
    "build": false,
    "flash": false,
    "reboot": false,
    "network_fetch": false
  },
  "evidence_requirements": [
    "validation_mode",
    "private_dns_mode",
    "dns_servers",
    "connectivity_check_urls",
    "connectivity_check_source",
    "apn_name",
    "apn_protocol",
    "apn_roaming_protocol"
  ],
  "unknown_evidence_rule": "explicit_UNKNOWN_never_inferred",
  "event_schema": {
    "required_fields": [
      "schema_version",
      "source_id",
      "sequence",
      "timestamp_utc",
      "source_clock_kind",
      "event_type",
      "phone_id",
      "slot_id",
      "subscription_ref",
      "cid",
      "payload",
      "evidence_ref"
    ],
    "allowed_event_types": [
      "SIM_STATE",
      "RADIO_STATE",
      "REGISTRATION",
      "BEARER",
      "VALIDATION",
      "DNS_PROBE",
      "VENDOR_DEACT",
      "DSRM_ACTION",
      "OPERATOR_ACTION",
      "ACTION_RESULT",
      "CAPTURE_GAP",
      "DEFAULT_DATA"
    ],
    "source_clock_kinds": [
      "UTC_ALIGNED",
      "DEVICE_REALTIME_ALIGNED",
      "UNKNOWN"
    ],
    "validation_bases": [
      "CAPABILITY_SNAPSHOT",
      "PROBE",
      "TRANSITION"
    ],
    "unknown_identity": null,
    "identity_rule": "time_scoped_explicit_mapping_no_inference_no_retroactive_application",
    "identity_conflict": "ABORT",
    "deduplication_key": [
      "source_id",
      "sequence"
    ],
    "duplicate_conflict": "ABORT",
    "extra_fields": "REJECT",
    "vendor_code": "opaque_single_canonical_form_no_decode",
    "vendor_code_form_conflict": "ABORT"
  },
  "qualification": {
    "required": [
      "explicit_time_scoped_subscription_mapping",
      "explicit_default_data_subscription",
      "sim_ready",
      "radio_on",
      "ps_registered",
      "bearer_active",
      "continuous_registration_samples",
      "continuous_bearer_samples",
      "continuous_validation_samples",
      "no_invalid_or_unknown_in_window",
      "stable_window"
    ],
    "thresholds": {
      "stable_window_seconds": 900,
      "max_sample_gap_seconds": 15,
      "active_probe_max_validation_age_seconds": 10
    },
    "thresholds_binding": true,
    "outcomes": {
      "connected_without_VALID": "INCONCLUSIVE",
      "connected_with_INVALID": "FAIL_INTERNET_VALIDATION",
      "observed_cycle_and_connected_without_VALID": "NOT_QUALIFIED",
      "capture_gap_or_clock_conflict": "INCONCLUSIVE",
      "no_default_data_evidence": "INCONCLUSIVE"
    },
    "validation_modes": [
      "PASSIVE_LOG",
      "ACTIVE_PROBE"
    ],
    "validation_mode_rules": {
      "PASSIVE_LOG": "CAPABILITY_SNAPSHOT_VALID_samples_continuous_TRANSITION_changes_state_only",
      "ACTIVE_PROBE": "PROBE_VALID_samples_bound_to_active_default_cid_continuous_last_within_max_age"
    },
    "window_restart_events": [
      "IDENTITY",
      "SIM",
      "RADIO",
      "REGISTRATION",
      "BEARER",
      "DEFAULT_DATA",
      "OPERATOR_ACTION",
      "CAPTURE_GAP",
      "VALIDATION_TRANSITION"
    ],
    "overall_verdict_rule": "default_data_subscription_only_never_inferred"
  },
  "gates": [
    "G00_PROVENANCE",
    "G01_SCHEMA",
    "G02_MAPPING",
    "G03_ORDERING",
    "G04_BEARER_VS_INTERNET",
    "G05_VENDOR_CAUSE",
    "G06_DSRM_ATTRIBUTION",
    "G07_RECOVERY_CYCLE",
    "G08_TEMPORAL_CAUSALITY",
    "G09_STOCK_PARITY",
    "G10_SAFETY",
    "G11_NEGATIVE_CASES",
    "G12_DUAL_SIM"
  ],
  "fixtures": [
    {
