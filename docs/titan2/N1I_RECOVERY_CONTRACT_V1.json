{
  "contract_id": "N1I_CELLULAR_RECOVERY",
  "version": "1.1",
  "status": "DESIGN_ONLY_NOT_PRODUCTION_AUTHORIZED",
  "execution_enabled": false,
  "authority": {
    "device_contact": false,
    "adb": false,
    "fastboot": false,
    "sim_movement": false,
    "settings_mutation": false,
    "source_mutation": false,
    "build": false,
    "flash": false,
    "reboot": false,
    "network_fetch": false
  },
  "event_schema": {
    "required_fields": [
      "schema_version",
      "source_id",
      "sequence",
      "timestamp_utc",
      "source_clock_kind",
      "event_type",
      "phone_id",
      "slot_id",
      "subscription_ref",
      "cid",
      "payload",
      "evidence_ref"
    ],
    "allowed_event_types": [
      "SIM_STATE",
      "RADIO_STATE",
      "REGISTRATION",
      "BEARER",
      "VALIDATION",
      "DNS_PROBE",
      "VENDOR_DEACT",
      "DSRM_ACTION",
      "OPERATOR_ACTION",
      "ACTION_RESULT",
      "CAPTURE_GAP"
    ],
    "source_clock_kinds": [
      "UTC_ALIGNED",
      "DEVICE_REALTIME_ALIGNED",
      "UNKNOWN"
    ],
    "unknown_identity": null,
    "identity_rule": "unknown_phone_slot_or_subscription_must_not_be_inferred",
    "deduplication_key": [
      "source_id",
      "sequence"
    ],
    "duplicate_conflict": "ABORT",
    "extra_fields": "REJECT",
    "vendor_code": "opaque_no_heuristic_decode"
  },
  "qualification": {
    "required": [
      "active_subscription_mapping",
      "sim_ready",
      "radio_on",
      "ps_registered",
      "bearer_active",
      "explicit_VALID_after_window_start",
      "continuous_stable_window"
    ],
    "thresholds": {
      "stable_window_seconds": 900,
      "max_sample_gap_seconds": 15,
      "active_probe_max_validation_age_seconds": 10
    },
    "thresholds_binding": true,
    "validation_modes": [
      "PASSIVE_LOG",
      "ACTIVE_PROBE"
    ],
    "validation_mode_rules": {
      "PASSIVE_LOG": "last_verdict_after_window_start_is_VALID_and_no_INVALID_since",
      "ACTIVE_PROBE": "VALID_probes_no_gap_over_max_sample_gap_and_last_within_max_validation_age"
    },
    "window_start_rule": "latest_of_identity_sim_radio_registration_bearer_or_operator_action",
    "outcomes": {
      "connected_without_VALID": "INCONCLUSIVE",
      "connected_with_INVALID": "FAIL_INTERNET_VALIDATION",
      "observed_cycle_and_connected_without_VALID": "NOT_QUALIFIED",
      "capture_gap_or_clock_conflict": "INCONCLUSIVE"
    }
  },
  "gates": [
    "G00_PROVENANCE",
    "G01_SCHEMA",
    "G02_MAPPING",
    "G03_ORDERING",
    "G04_BEARER_VS_INTERNET",
    "G05_VENDOR_CAUSE",
    "G06_DSRM_ATTRIBUTION",
    "G07_RECOVERY_CYCLE",
    "G08_TEMPORAL_CAUSALITY",
    "G09_STOCK_PARITY",
    "G10_SAFETY",
    "G11_NEGATIVE_CASES",
    "G12_DUAL_SIM"
  ],
  "fixtures": [
    {
      "id": "F01_OCT03_STABLE",
      "scenario": "tray1_phone0_validated_continuous_window_with_exact_duplicate",
      "expected": "HISTORICAL_STABLE_BASELINE_ONLY",
      "gates": [
        "G02_MAPPING",
        "G03_ORDERING"
      ],
      "bundle": "F01_OCT03_STABLE.json",
      "assert": {
        "outcome": "VALIDATED_STABLE",
        "subscriptions": [
          "S1"
        ],
        "dsds": "NOT_QUALIFIED_SINGLE_SIM_EVIDENCE"
      }
    },
    {
      "id": "F02_OCT09_LOSS",
      "scenario": "tray2_phone1_dns_invalid_dsrm_selection_vendor_deact_0x140F7C_rejects_15_13_11",
      "expected": "LOST_UNKNOWN_ROOT_CAUSE",
      "gates": [
        "G02_MAPPING",
        "G03_ORDERING",
        "G05_VENDOR_CAUSE",
        "G06_DSRM_ATTRIBUTION"
      ],
      "bundle": "F02_OCT09_LOSS.json",
      "assert": {
        "outcome": "LOST",
        "root_cause": "UNKNOWN",
        "subscriptions": [
          "S1"
        ],
        "ignored_phones": [
          0
        ],
        "loss_sequence": [
          "DNS_TIMEOUT",
          "VALIDATION_INVALID",
          "VENDOR_DEACT",
          "BEARER_INACTIVE",
          "PS_DEREGISTERED"
        ],
        "vendor_codes": [
          "0x140F7C"
        ],
        "dsrm_executed": [],
        "dsrm_selected_not_executed": [
          "GET_DATA_CALL_LIST:SELECTED",
          "GET_DATA_CALL_LIST:SKIPPED"
        ]
      }
    },
    {
      "id": "F03_POST_CYCLE_INVALID",
      "scenario": "loss_then_radio_cycle_fresh_bearer_then_invalid",
      "expected": "FAIL_INTERNET_VALIDATION",
      "gates": [
        "G04_BEARER_VS_INTERNET",
        "G07_RECOVERY_CYCLE"
      ],
      "bundle": "F03_POST_CYCLE_INVALID.json",
      "assert": {
        "outcome": "FAIL_INTERNET_VALIDATION",
        "root_cause": "UNKNOWN",
        "post_failure_actions": [
          "RADIO_CYCLE"
        ]
      }
    },
    {
      "id": "F04_STOCK_DIFFERENT_CAUSE",
      "scenario": "stock_res_1317585_0x141AD1_reject_27_then_active_bearer",
      "expected": "BEARER_RECOVERED_DIFFERENT_INITIAL_CAUSE",
      "gates": [
        "G05_VENDOR_CAUSE",
        "G09_STOCK_PARITY"
      ],
      "bundle": "F04_STOCK_DIFFERENT_CAUSE.json",
      "assert": {
        "outcome": "INCONCLUSIVE",
        "inconclusive_reason": "WINDOW_INCOMPLETE",
        "bearer_recovered": true,
        "vendor_codes": [
          "0x141AD1"
        ]
      }
    },
    {
      "id": "F05_EMPTY_PHONE0_ERROR",
      "scenario": "phone0_absent_reports_error_phone1_connects",
      "expected": "DO_NOT_FAIL_ACTIVE_PHONE1",
      "gates": [
        "G02_MAPPING"
      ],
      "bundle": "F05_EMPTY_PHONE0_ERROR.json",
      "assert": {
        "subscriptions": [
          "S1"
        ],
        "ignored_phones": [
          0
        ],
        "outcome": "INCONCLUSIVE",
        "inconclusive_reason": "WINDOW_INCOMPLETE"
      }
    },
    {
      "id": "F06_NO_VALIDATION",
      "scenario": "bearer_connected_full_window_no_validation",
      "expected": "INCONCLUSIVE",
      "gates": [
        "G04_BEARER_VS_INTERNET"
      ],
      "bundle": "F06_NO_VALIDATION.json",
      "assert": {
        "outcome": "INCONCLUSIVE",
        "inconclusive_reason": "VALIDATION_PENDING"
      }
    },
    {
      "id": "F07_LATE_APN_TRIAL",
      "scenario": "apn_trial_after_original_failure",
      "expected": "NOT_PRIOR_CAUSE",
      "gates": [
        "G08_TEMPORAL_CAUSALITY"
      ],
      "bundle": "F07_LATE_APN_TRIAL.json",
      "assert": {
        "outcome": "LOST",
        "prior_cause_candidates": [
          "SIM_TOGGLE_BEFORE"
        ],
        "post_failure_actions": [
          "APN_TRIAL"
        ]
      }
    },
    {
      "id": "F08_UNAUTHORIZED_ACTION",
      "scenario": "offline_replay_requests_adb_radio_flash_simswitch",
      "expected": "DENY",
      "gates": [
        "G10_SAFETY"
      ],
      "bundle": "F08_UNAUTHORIZED_ACTION.json",
      "assert": {
        "action_decisions": {
          "ADB_SHELL": "DENY",
          "RADIO_CYCLE": "DENY",
          "FLASH_SYSTEM": "DENY",
          "SET_SIMSWITCH_PROPERTY": "DENY"
        }
      }
    },
    {
      "id": "F09_CORRUPT_EVIDENCE",
      "scenario": "sha256_mismatch_with_unparseable_event",
      "expected": "ABORT",
      "gates": [
        "G00_PROVENANCE",
        "G11_NEGATIVE_CASES"
      ],
      "bundle": "F09_CORRUPT_EVIDENCE.json",
      "assert": {
        "abort": "SHA256_MISMATCH"
      }
    },
    {
      "id": "F10_DSDS",
      "scenario": "two_subscriptions_no_state_leakage",
      "expected": "DSDS_NOT_QUALIFIED_OFFLINE",
      "gates": [
        "G12_DUAL_SIM"
      ],
      "bundle": "F10_DSDS.json",
      "assert": {
        "per_subscription": {
          "S1": "VALIDATED_STABLE",
          "S2": "LOST"
        },
        "dsds": "NOT_QUALIFIED_OFFLINE_REQUIRES_PHYSICAL"
      }
    },
    {
      "id": "F11_STOCK_TRANSIENT_RECOVERED",
      "scenario": "stock_transient_error_unspecified_reject_27_recovered_then_stable",
      "expected": "TRANSIENT_TOLERATED",
      "gates": [
        "G09_STOCK_PARITY"
      ],
      "bundle": "F11_STOCK_TRANSIENT_RECOVERED.json",
      "assert": {
        "outcome": "VALIDATED_STABLE",
        "bearer_recovered": true,
        "transient_losses": 1
      }
    },
    {
      "id": "F12_UNKNOWN_CLOCK",
      "scenario": "one_source_unknown_clock",
      "expected": "INCONCLUSIVE",
      "gates": [
        "G00_PROVENANCE",
        "G11_NEGATIVE_CASES"
      ],
      "bundle": "F12_UNKNOWN_CLOCK.json",
      "assert": {
        "outcome": "INCONCLUSIVE",
        "inconclusive_reason": "CLOCK_UNKNOWN"
      }
    },
    {
      "id": "F13_NO_SUB_MAPPING",
      "scenario": "sim_loaded_without_subscription_ref",
      "expected": "UNKNOWN",
      "gates": [
        "G02_MAPPING",
        "G11_NEGATIVE_CASES"
      ],
      "bundle": "F13_NO_SUB_MAPPING.json",
      "assert": {
        "outcome": "UNKNOWN",
        "inconclusive_reason": "NO_SUBSCRIPTION_MAPPING",
        "subscriptions": []
      }
    },
    {
      "id": "F14_STALE_VALIDATION",
      "scenario": "active_probe_mode_probes_stop",
      "expected": "INCONCLUSIVE",
      "gates": [
        "G11_NEGATIVE_CASES"
      ],
      "bundle": "F14_STALE_VALIDATION.json",
      "assert": {
        "outcome": "INCONCLUSIVE",
        "inconclusive_reason": "VALIDATION_STALE"
      }
    },
    {
      "id": "F15_CAPTURE_GAP",
      "scenario": "sixty_second_capture_gap_in_window",
      "expected": "INCONCLUSIVE",
      "gates": [
        "G11_NEGATIVE_CASES"
      ],
      "bundle": "F15_CAPTURE_GAP.json",
      "assert": {
        "outcome": "INCONCLUSIVE",
        "inconclusive_reason": "CAPTURE_GAP"
      }
    },
    {
      "id": "F16_DUPLICATE_CONFLICT",
      "scenario": "same_source_sequence_different_content",
      "expected": "ABORT",
      "gates": [
        "G03_ORDERING",
        "G11_NEGATIVE_CASES"
      ],
      "bundle": "F16_DUPLICATE_CONFLICT.json",
      "assert": {
        "abort": "DUPLICATE_CONFLICT"
      }
    },
    {
      "id": "F17_SCHEMA_EXTRA_FIELD",
      "scenario": "event_with_extra_execute_field",
      "expected": "ABORT",
      "gates": [
        "G01_SCHEMA"
      ],
      "bundle": "F17_SCHEMA_EXTRA_FIELD.json",
      "assert": {
        "abort": "SCHEMA"
      }
    },
    {
      "id": "F18_INVALID_EVENT_TYPE",
      "scenario": "unknown_event_type",
      "expected": "ABORT",
      "gates": [
        "G01_SCHEMA"
      ],
      "bundle": "F18_INVALID_EVENT_TYPE.json",
      "assert": {
        "abort": "SCHEMA"
      }
    },
    {
      "id": "F19_DSRM_EXECUTED",
      "scenario": "dsrm_radio_restart_selected_and_executed",
      "expected": "DSRM_EXECUTION_ATTRIBUTED",
      "gates": [
        "G06_DSRM_ATTRIBUTION"
      ],
      "bundle": "F19_DSRM_EXECUTED.json",
      "assert": {
        "dsrm_executed": [
          "RADIO_RESTART:EXECUTED"
        ],
        "dsrm_selected_not_executed": [
          "RADIO_RESTART:SELECTED"
        ]
      }
    },
    {
      "id": "F20_CYCLE_NO_VALID",
      "scenario": "radio_cycle_then_connected_without_valid",
      "expected": "NOT_QUALIFIED",
      "gates": [
        "G07_RECOVERY_CYCLE"
      ],
      "bundle": "F20_CYCLE_NO_VALID.json",
      "assert": {
        "outcome": "NOT_QUALIFIED"
      }
    }
  ]
}
