# Titan 2 N1I stock-to-GSI consolidated decision. SKELETON.
# Companion to docs/titan2/N1I_STOCK_TO_GSI_DECISION.md.
# Every value starts PENDING. The operator replaces it on the build host from
# sealed evidence. Missing sealed evidence => UNKNOWN_EVIDENCE_NOT_ACCESSIBLE.
# Authority markers are fixed NO and must not be changed by this review.

N1I_DECISION_ENV_VERSION=1
REVIEW_DATE=PENDING
REVIEW_HOST=PENDING
REPO_HEAD_USED=PENDING

# G0 provenance. Allowed: VERIFIED | MISMATCH | UNKNOWN_EVIDENCE_NOT_ACCESSIBLE
G0_STOCK_ARTIFACTS=PENDING
G0_STOCK_RUNTIME_TRAY1=PENDING
G0_STOCK_RUNTIME_TRAY2=PENDING
G0_C3A_IMAGE=PENDING
G0_N1F_IMAGE=PENDING
G0_N1F_COLLAPSE_CAPTURE=PENDING
G0_N1IA_CLOSURE=PENDING
G0_C1_IMAGE=PENDING
G0_C2_IMAGE=PENDING
G0_D0_RUN=PENDING
G0_D1R1_IMAGE=PENDING
G0_D1R2_IMAGE=PENDING
C1_SYSTEM_SHA256=PENDING
C2_SYSTEM_SHA256=PENDING
D1R1_SYSTEM_SHA256=PENDING
D1R2_SYSTEM_SHA256=fb87b6a07b59a950b625557c95cc95bcad9dd6fac41d0480389bd0b922bab415
SYSTEM_A_IMAGE_SHA256_ON_DEVICE=PENDING
USERDATA_STATE=PENDING

# G1 static Java/classpath. Allowed: PASS | FAIL:<class> | UNKNOWN
G1_C1=PENDING
G1_C2=PENDING
G1_D1R2=PENDING
G1_TELEPHONYMETRICS_WRITERILANSWER_GAP=PENDING      # REPO evidence says CONFIRMED; verify
G1_METHOD_BODY_COMPARISON=PENDING                   # NOT_PERFORMED_REMAINS_UNKNOWN | NARROW_EXCEPTION_PERFORMED

# G2 boot-fatal closure (D0 gates). Allowed: BOOT_FATAL | FUNCTIONAL_RISK | PASS | UNKNOWN
D0_SEALED_RUN_EXISTS=PENDING
D0_COVERS_D1R2=PENDING
G2_GATE_A_SELINUX=PENDING
G2_GATE_B_PROPERTY_CONTEXTS=PENDING
G2_GATE_C_SERVICE_VINTF=PENDING
G2_GATE_D_PRIVAPP_SHARED_UID=PENDING
G2_GATE_E_BOOTCLASSPATH_APEX=PENDING

# G3 registration loss. Allowed: YES | NO | UNKNOWN unless noted
G3_GSI_DEFAULT_APN=PENDING                          # REPO: pwg
G3_STOCK_DEFAULT_APN=PENDING                        # REPO: fast.t-mobile.com
G3_GSI_IA_TYPED_APN_FOR_SIM_PRESENT=PENDING         # REPO source: NO (310240/GID 6901 pwg is default,supl,mms)
G3_GSI_IMS_TYPED_APN_FOR_SIM_PRESENT=PENDING        # REPO source: NO
G3_GSI_RUNTIME_IA_APN_PUSHED=PENDING                # from "Initial attach data profile updated as"
G3_STOCK_RUNTIME_IA_APN=PENDING
G3_GSI_PROXYCONTROLLER_RESULT=PENDING               # NEW_REQUEST_SESSION | ALREADY_IN_REQUESTED_CONFIGURATION | NOT_IN_LOG
G3_FIRST_DIVERGENCE_STEP=PENDING
G3_FIRST_DIVERGENCE_EVIDENCE=PENDING
APN_ONLY_FIX_JUSTIFIED=NO                           # stays NO unless a runtime A/B proves otherwise

# G4 decision
# NEXT_ARCHITECTURE_DECISION allowed:
#   GO_HOST_ONLY_MINIMAL_COMPAT_DELTA | GO_LINEAGE_TITAN_OFFLINE_REFERENCE |
#   HOLD_EXACT_MISSING_EVIDENCE | HOLD_BOOT_ROOT_CAUSE_UNRESOLVED
NEXT_ARCHITECTURE_DECISION=PENDING
TRUE_GAP_COUNT=PENDING

# Final markers
STOCK_ARTIFACT_INVENTORY=PENDING
STOCK_OEM_IMS_STATIC_CLOSURE=PENDING
STOCK_VS_C3A_METHOD_BEHAVIOR=PENDING
C1_C2_D1R2_BOOT_FATAL_DIFFERENCE=PENDING
GSI_REGISTRATION_LOSS_CAUSE=PENDING

# Authority (fixed)
STOCK_RERESTORE_AUTHORIZED=NO
DEVICE_CONTACT_AUTHORIZED=NO
BUILD_AUTHORIZED=NO
FLASH_AUTHORIZED=NO
