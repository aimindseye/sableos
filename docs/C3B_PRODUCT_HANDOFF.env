# C3B product-lane handoff TEMPLATE. Describes policy and expected fields only.
# It never embeds its own commit SHA. The exact source identity is the runtime value of `git rev-parse HEAD`,
# recorded in the generated PR body (build/titan2/render-c3b-deliverable-pr.sh), operator validation and canonical CI evidence.

C3B_PRODUCT_HANDOFF_VERSION=2
C3B_PRODUCT_SOURCE_REPO=aimindseye/titan2-temp
C3B_PRODUCT_SOURCE_IDENTITY_MODE=RUNTIME_GIT_HEAD
C3B_RELEASE_TRACK=N1D
C3B_BASELINE_PHASE=C3B
C3B_DELIVERABLE_KIND=C3B_PRODUCT_SOURCE_CANDIDATE

# Android target (informational; the canonical lane owns the final build).
C3B_PRODUCT_ANDROID_RELEASE=16
C3B_PRODUCT_COMPILE_SDK=36

# Profile data (ordinary data, not Android system properties).
C3B_PRODUCT_PROFILES=titan2,titan2-elite
C3B_PRODUCT_PROFILE_EVIDENCE_INHERITANCE=NO

# Authorizations (all NO in the product lane).
C3B_PRODUCT_RELEASE_ELIGIBLE=NO
C3B_PRODUCT_FLASH_AUTHORIZED=NO
C3B_PRODUCT_PRODUCTION_SIGNING_AUTHORIZED=NO
C3B_PRODUCT_DEVICE_CONTACT_AUTHORIZED=NO
C3B_PRODUCT_RADIO_CHANGES_ALLOWED=NO

# Product model.
C3B_PRODUCT_AUTHORITY=CANONICAL_C3B_LANE
C3B_PRODUCT_FRAGMENT_SUPPLIED=NO
C3B_PRODUCT_PRESIGNED_PREBUILT_APK_MODEL=NO
C3B_PRODUCT_HOME_OWNER=Launcher3QuickStep
C3B_PRODUCT_STANDALONE_HOME_APP=NO
C3B_PRODUCT_FACTORY_DEFAULT_HOME=SableStart
C3B_PRODUCT_THIRD_PARTY_HOME_SELECTION_ALLOWED=YES
C3B_PRODUCT_FORCE_HOME_AFTER_USER_SELECTION=NO
C3B_PRODUCT_FIRST_PARTY_IME=SableKeyboard
C3B_PRODUCT_FACTORY_DEFAULT_IME=SableKeyboard_PENDING_IR005
C3B_PRODUCT_THIRD_PARTY_IME_SELECTION_ALLOWED=YES
C3B_PRODUCT_FORCE_IME_AFTER_USER_SELECTION=NO

# Rust (declare per deliverable).
C3B_PRODUCT_RUST_DEPENDENCY=NONE

# Reference bindings. platform_sable is bound in C3B_PLATFORM_SABLE_BINDING.env.
C3B_PRODUCT_SURFACE_MATRIX=docs/C3B_PRODUCT_SURFACE_MATRIX.tsv
C3B_PRODUCT_INTERFACE_REQUESTS=docs/C3B_PLATFORM_INTERFACE_REQUESTS.tsv
C3B_PRODUCT_SOURCE_MODULES=docs/C3B_PRODUCT_SOURCE_MODULES.tsv
C3B_PRODUCT_PATH_OWNERSHIP=docs/C3B_PRODUCT_PATH_OWNERSHIP.tsv
C3B_PRODUCT_KNOWN_LIMITATIONS=docs/C3B_PRODUCT_KNOWN_LIMITATIONS.md
C3B_PRODUCT_RETIRED_PATHS=docs/C3B_PRODUCT_RETIRED_PATHS.tsv
C3B_PRODUCT_INTERFACE_EVIDENCE=docs/C3B_PRODUCT_INTERFACE_EVIDENCE.md
C3B_PRODUCT_TYPE_TO_FIND_REFERENCE=reference/sable-start-type-to-find
C3B_PRODUCT_CAMERA_CONTROL_DECK=docs/SABLE_CAMERA_CONTROL_DECK.md
C3B_PRODUCT_PASTIERA_086_REFERENCE=docs/PASTIERA_086_REFERENCE_INTAKE.md

# Expected results are produced by validation, never pre-filled here:
#   developer: C3B_PRODUCT_SOURCE_STATIC_QUALIFICATION, C3B_PRODUCT_DEVELOPER_ANDROID_COMPILE, JVM_SHIM_TESTS
#   operator : C3B_PRODUCT_AI_G732_ANDROID_COMPILE, C3B_PRODUCT_AI_G732_CI, C3B_PRODUCT_SOURCE_QUALIFICATION (--full)
