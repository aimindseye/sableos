<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.telephony.messaging"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <queries>
        <provider android:authorities="org.sableos.start.appearance" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_sable_messages"
        android:roundIcon="@drawable/ic_sable_messages"
        android:label="Sable Messages"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".web.WhatsAppCapsuleActivity"
            android:exported="false"
            android:process=":whatsapp" />
        <activity
            android:name=".web.InstagramCapsuleActivity"
            android:exported="false"
            android:process=":instagram" />
        <activity
            android:name=".web.MessengerCapsuleActivity"
            android:exported="false"
            android:process=":messenger" />
        <activity
            android:name=".web.LinkedInCapsuleActivity"
            android:exported="false"
            android:process=":linkedin" />
    </application>
</manifest>
