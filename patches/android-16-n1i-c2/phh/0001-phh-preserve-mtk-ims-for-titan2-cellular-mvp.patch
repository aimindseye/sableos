From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SableOS Engineering <engineering@sableos.org>
Date: Mon, 5 Oct 2026 00:00:00 +0000
Subject: [PATCH] phh: preserve MTK IMS for Titan 2 Cellular MVP

The generic PHH mtkmal branch disables persist.mtk_ims_support and
persist.mtk_epdg_support, then reboots. That is opposite to the N1I-C2 OEM IMS
candidate.

Gate that generic behavior only when the Sable Titan 2 Cellular MVP marker is
absent. Other PHH/Treble targets retain the existing behavior unchanged.
---
 phh-on-boot.sh | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/phh-on-boot.sh b/phh-on-boot.sh
--- a/phh-on-boot.sh
+++ b/phh-on-boot.sh
@@ -15,7 +15,9 @@ for i in wpa p2p;do
 	chown wifi:system /data/misc/wifi/${i}_supplicant.conf
 done
 
-if [ -f /vendor/bin/mtkmal ];then
+# SableOS Titan 2 Cellular MVP keeps stock MTK IMS/ePDG support enabled.
+if [ -f /vendor/bin/mtkmal ] && \
+    [ ! -f /system_ext/etc/sable/titan2-cellular-mvp ];then
     if [ "$(getprop persist.mtk_ims_support)" = 1 ] || [ "$(getprop persist.mtk_epdg_support)" = 1 ];then
         setprop persist.mtk_ims_support 0
         setprop persist.mtk_epdg_support 0
-- 
